# ==============================================================================
# OROÑO BIKE - ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ARCA (ex-AFIP) WebServices Credentials
ARCA_CUIT=20301234567
ARCA_CERT_PATH=/secrets/afip_cert.crt
ARCA_KEY_PATH=/secrets/afip_private.key
ARCA_PRODUCTION=false
ARCA_PUNTO_VENTA=1

# Mercado Pago Credentials
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-signature-secret

# Logistics & Commerce Settings
NEXT_PUBLIC_LOCAL_WHATSAPP=5493410000000
NEXT_PUBLIC_STORE_ADDRESS="Bv. Nicasio Oroño 1234, Rosario, Santa Fe"
ANDREANI_API_KEY=your-andreani-api-key
