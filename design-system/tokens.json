{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "OronoBikeDesignTokens",
  "version": "1.0.0",
  "author": "Google Stitch / Lead UI Designer",
  "theme": {
    "colors": {
      "bg-primary": "#ffffff",
      "bg-secondary": "#fafafa",
      "bg-muted": "#f4f4f5",
      "text-primary": "#09090b",
      "text-secondary": "#52525b",
      "text-muted": "#71717a",
      "border-subtle": "#e4e4e7",
      "border-strong": "#27272a",
      "accent-black": "#09090b",
      "status-success": "#16a34a",
      "status-warning": "#d97706",
      "status-danger": "#dc2626",
      "brand-whatsapp": "#25D366",
      "brand-instagram": "#E1306C"
    },
    "typography": {
      "fontSans": "var(--font-sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif)",
      "fontMono": "var(--font-mono, 'Geist Mono', monospace)",
      "weights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      }
    },
    "radius": {
      "sm": "0.125rem",
      "md": "0.375rem",
      "lg": "0.5rem",
      "full": "9999px"
    },
    "shadows": {
      "subtle": "0 1px 3px 0 rgba(0, 0, 0, 0.05)",
      "card": "0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05)",
      "floating": "0 12px 24px -4px rgba(0, 0, 0, 0.12)"
    }
  }
}
